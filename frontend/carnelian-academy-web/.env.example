# Copy to .env.local (ignored by Git) and adjust for your machine.
# Base URL of the local Carnelian Academy API (see the root README, "Local setup").
# Do not put tokens, passwords, or other secrets here: every VITE_ variable is embedded in the browser bundle.
VITE_API_BASE_URL=https://localhost:7159
# Optional per-request timeout in milliseconds (1000-120000). Defaults to 20000 when unset.
# VITE_API_TIMEOUT_MS=20000
